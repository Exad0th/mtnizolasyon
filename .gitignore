# ---------- Yerel yedekler (repoya girmez) ----------
# optimizasyon öncesi ham fotoğraflar (~34 MB)
images-original/
# siteden kaldırılan, telifi bize ait olmayan görseller
_kaldirilan-gorseller/
# müşteriden gelen ham dosyalar: telif durumu teyit edilmemiş görseller içerebilir
_gelen/
# müşterinin pazarlama verileri (otel iletişim listeleri): kişisel veri içerebilir, repoya ve sunucuya girmez
_pazarlama/

# ---------- _kurulum: betikler ve notlar girer, günlükler girmez ----------
# FTP oturum dökümleri: makine adı ve bağlantı ayrıntısı içerir
_kurulum/*log*.txt

# ---------- Üretilen dosyalar ----------
mtn-yayin.zip
*.bak

# ---------- Araç / sistem ----------
.claude/
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
desktop.ini
